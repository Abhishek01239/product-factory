# ============================================================
# Autonomous Product Factory — environment template
# Copy to .env and fill in.  NEVER commit the real .env.
# Every secret is read from the environment / GH Actions
# secrets at runtime; nothing is stored in this repo.
# ============================================================

# ---------- Factory behavior ----------
# autonomous | approval_required (default: approval_required — deployment
# and distribution stop for human approval in this mode)
FACTORY_MODE=approval_required
# Set to 1 to simulate all AI calls deterministically (no API key needed).
# Used for offline end-to-end testing; never for real production output.
FACTORY_MOCK_AI=0

# ---------- AI inference ----------
# Groq is the primary provider. Get a key at https://console.groq.com/keys
# (free tier available). In GitHub Actions this must be a repository secret.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Deployment ----------
# Vercel token: https://vercel.com/account/tokens
VERCEL_TOKEN=
# GitHub token (usually injected automatically by Actions — no need to set)
GITHUB_TOKEN=

# ---------- Distribution platforms (only activate what you configure) ---
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dev.to (https://dev.to/settings/extensions -> API key)
DEVTO_API_KEY=
# Discord (channel webhook URL)
DISCORD_WEBHOOK_URL=
# Bluesky (https://bsky.app/settings/app-passwords)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Mastodon (instance + access token from Settings -> Development)
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=
# Reddit (script app: https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# X / LinkedIn / YouTube require OAuth apps — see README
X_BEARER_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------- Budget caps (override factory.json) ----------
FACTORY_MAX_PROJECTS_PER_RUN=
FACTORY_MAX_REPAIR_ATTEMPTS=
FACTORY_MAX_AI_REQUESTS=